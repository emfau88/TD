{
  "name": "spire-defense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "reference:dev": "node scripts/reference.mjs dev",
    "reference:build": "node scripts/reference.mjs build",
    "reference:style:build": "node scripts/reference.mjs style-build",
    "reference:forest:build": "node scripts/reference.mjs forest-build",
    "reference:regions:build": "node scripts/reference.mjs forest-build",
    "reference:enemy:build": "node scripts/reference.mjs enemy-build",
    "reference:succubus:build": "node scripts/reference.mjs succubus-build",
    "reference:test": "node scripts/reference.mjs test",
    "dev": "npm run idle:dev",
    "build": "npm run idle:build && node scripts/package-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "test": "npm run idle:test",
    "idle:dev": "vite --config experiments/idle-bastion/vite.config.ts",
    "idle:build": "tsc --project experiments/idle-bastion/tsconfig.json --noEmit && vite build --config experiments/idle-bastion/vite.config.ts",
    "idle:preview": "vite preview --config experiments/idle-bastion/vite.config.ts",
    "idle:test": "tsx --test experiments/idle-bastion/tests/*.test.ts",
    "classic:dev": "vite --host 127.0.0.1",
    "classic:build": "tsc --noEmit && vite build && node scripts/package-offline.mjs",
    "classic:preview": "vite preview --host 127.0.0.1",
    "classic:test": "tsx --test tests/*.test.ts",
    "classic:test:ui": "node scripts/check-ui.mjs",
    "classic:test:scene": "node scripts/check-scene.mjs",
    "classic:test:package": "node scripts/check-package.mjs",
    "classic:balance:sim": "tsx scripts/balance.ts",
    "build:kongregate": "tsc --project experiments/idle-bastion/tsconfig.json --noEmit && vite build --config experiments/idle-bastion/vite.kongregate.config.ts",
    "package:kongregate": "python scripts/package-kongregate.py"
  },
  "dependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
